<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/2006/util">
  <!--
    TrayPrint — WiX Toolset v3.x Installer Definition

    Build with:
      candle.exe -ext WixUtilExtension product.wxs
      light.exe -ext WixUtilExtension -out TrayPrint.msi product.wixobj

    Prerequisites:
      - WiX Toolset v3.14 or later (https://wixtoolset.org)
      - Built TrayPrint executable (trayprint.exe) in the parent directory
  -->

  <Product
    Id="*"
    Name="TrayPrint"
    Language="1033"
    Version="1.0.0"
    Manufacturer="Print Hub"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
  >
    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="TrayPrint – Local Print Agent for Print Hub"
      Comments="TrayPrint v1.0.0 — Windows Print Agent"
      Manufacturer="Print Hub"
    />

    <!-- The product is a 64-bit application. -->
    <Condition Message="This installer requires a 64-bit version of Windows.">
      VersionNT64
    </Condition>

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="TrayPrint">
          <!-- Main executable -->
          <Component Id="C_TrayPrintExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901" Win64="yes">
            <File
              Id="F_TrayPrintExe"
              Name="trayprint.exe"
              Source="..\dist\trayprint.exe"
              KeyPath="yes"
              Checksum="yes"
            />

            <!-- Shortcut in Start Menu -->
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuDir"
              Name="TrayPrint"
              WorkingDirectory="APPLICATIONFOLDER"
              Icon="TrayPrintIcon"
            />
          </Component>

          <!-- Configuration file (created on first launch) -->
          <Component Id="C_ConfigJson" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012" Win64="yes">
            <File
              Id="F_ConfigJson"
              Name="config.json"
              Source="..\config.json"
              KeyPath="yes"
            />
          </Component>

          <!-- PowerShell script: Register Scheduled Task -->
          <Component Id="C_RegisterTaskScript" Guid="F6A7B8C9-D0E1-2345-6789-ABCDEF012345" Win64="yes">
            <File
              Id="F_RegisterTaskScript"
              Name="Register-TrayPrintTask.ps1"
              Source="Register-TrayPrintTask.ps1"
              KeyPath="yes"
            />
          </Component>

          <!-- PowerShell script: Unregister Scheduled Task -->
          <Component Id="C_UnregisterTaskScript" Guid="A7B8C9D0-E1F2-3456-789A-BCDEF0123456" Win64="yes">
            <File
              Id="F_UnregisterTaskScript"
              Name="Unregister-TrayPrintTask.ps1"
              Source="Unregister-TrayPrintTask.ps1"
              KeyPath="yes"
            />
          </Component>
        </Directory>
      </Directory>

      <!-- Start Menu folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="TrayPrint" />
      </Directory>

      <!-- Desktop shortcut folder -->
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="C_DesktopShortcut" Guid="D4E5F6A7-B8C9-0123-DEF1-234567890123" Win64="yes">
        <Shortcut
          Id="DesktopShortcut"
          Directory="DesktopFolder"
          Name="TrayPrint"
          WorkingDirectory="APPLICATIONFOLDER"
          Target="[APPLICATIONFOLDER]trayprint.exe"
          Icon="TrayPrintIcon"
        />
        <RegistryValue
          Root="HKCU"
          Key="Software\PrintHub\TrayPrint"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="F_MainApplication" Title="TrayPrint" Level="1" Description="TrayPrint executable and configuration.">
      <ComponentRef Id="C_TrayPrintExe" />
      <ComponentRef Id="C_ConfigJson" />
      <ComponentRef Id="C_DesktopShortcut" />
      <ComponentRef Id="C_RegisterTaskScript" />
      <ComponentRef Id="C_UnregisterTaskScript" />
    </Feature>

    <!-- Icon reference -->
    <Icon Id="TrayPrintIcon" SourceFile="..\trayprint.ico" />

    <!-- UI — use the standard WiX MSI dialog set -->
    <UIRef Id="WixUI_Minimal" />

    <!-- Allow upgrading from previous versions -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of TrayPrint is already installed."
      Schedule="afterInstallValidate"
    />

    <!--
      ── Scheduled Task Custom Actions ──
      Uses WixQuietExec (from WixUtilExtension) to run PowerShell scripts
      silently during install / uninstall with SYSTEM privileges.
    -->

    <!-- Register Scheduled Task (deferred, no impersonation — runs as SYSTEM) -->
    <CustomAction
      Id="RegisterScheduledTask"
      BinaryKey="WixCA"
      JScriptCall="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
    />
    <CustomAction
      Id="RegisterScheduledTask_SetProperty"
      Property="RegisterScheduledTask"
      Value=""[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" -ExecutionPolicy Bypass -File "[APPLICATIONFOLDER]Register-TrayPrintTask.ps1" -InstallPath "[APPLICATIONFOLDER]""
    />

    <!-- Unregister Scheduled Task (deferred, no impersonation — runs as SYSTEM) -->
    <CustomAction
      Id="UnregisterScheduledTask"
      BinaryKey="WixCA"
      JScriptCall="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
    />
    <CustomAction
      Id="UnregisterScheduledTask_SetProperty"
      Property="UnregisterScheduledTask"
      Value=""[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" -ExecutionPolicy Bypass -File "[APPLICATIONFOLDER]Unregister-TrayPrintTask.ps1""
    />

    <!-- Custom action to run TrayPrint after installation -->
    <CustomAction
      Id="LaunchApplication"
      FileKey="F_TrayPrintExe"
      ExeCommand=""
      Execute="immediate"
      Return="asyncNoWait"
    />

    <InstallExecuteSequence>
      <!-- Schedule task registration AFTER files are installed -->
      <Custom Action="RegisterScheduledTask_SetProperty" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="RegisterScheduledTask" After="RegisterScheduledTask_SetProperty">NOT Installed AND NOT REMOVE</Custom>

      <!-- Schedule task unregistration BEFORE files are removed -->
      <Custom Action="UnregisterScheduledTask_SetProperty" After="InstallInitialize">REMOVE</Custom>
      <Custom Action="UnregisterScheduledTask" After="UnregisterScheduledTask_SetProperty">REMOVE</Custom>

      <!-- Launch application after install completes -->
      <Custom Action="LaunchApplication" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
